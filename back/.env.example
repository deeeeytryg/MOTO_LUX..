# Copia este archivo como .env para desarrollo local.

# Puerto del servidor
PORT=3001

# Orígenes (URLs del front) que pueden llamar a la API, separados por coma, sin "/" final.
# En producción: https://deeeeytryg.github.io
ALLOWED_ORIGINS=http://localhost:5173

# Postgres (Supabase): Connect → "Session pooler" → copia la URI y reemplaza [YOUR-PASSWORD].
# Tiene la forma postgresql://postgres.<ref>:<password>@aws-...pooler.supabase.com:5432/postgres
DATABASE_URL=

# Administrador del panel (#/admin). Si no defines ADMIN_PASSWORD en desarrollo, se genera una y se muestra en la consola.
ADMIN_EMAIL=admin@motolux.co
ADMIN_PASSWORD=
# Secreto para firmar los tokens. Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
