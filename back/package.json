{
  "name": "motolux-back",
  "version": "1.0.0",
  "private": true,
  "description": "API de MotoLux: catálogo, contacto, chat con IA y panel administrativo.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
